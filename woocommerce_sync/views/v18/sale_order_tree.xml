<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sale_order_tree_woocommerce" model="ir.ui.view">
    <field name="name">sale.order.tree.woocommerce</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//list" position="inside">
        <field name="woocommerce_site_url" optional="show"/>
        <field name="woocommerce_id" optional="show"/>
        <field name="woocommerce_number" optional="show"/>
        <field name="woocommerce_created_via" optional="show"/>
        <field name="woocommerce_date_created_gmt" optional="show"/>
        <field name="woocommerce_total" optional="hide"/>
        <field name="woocommerce_total_tax" optional="hide"/>
        <field name="woocommerce_customer_id" optional="hide"/>
        <field name="woocommerce_payment_method" optional="hide"/>
        <field name="woocommerce_payment_method_title" optional="hide"/>
        <field name="woocommerce_billing_first_name" optional="hide"/>
        <field name="woocommerce_billing_last_name" optional="hide"/>
        <field name="woocommerce_billing_company" optional="hide"/>
        <field name="woocommerce_billing_address_1" optional="hide"/>
        <field name="woocommerce_billing_address_2" optional="hide"/>
        <field name="woocommerce_billing_city" optional="hide"/>
        <field name="woocommerce_billing_state" optional="hide"/>
        <field name="woocommerce_billing_postcode" optional="hide"/>
        <field name="woocommerce_billing_country" optional="hide"/>
        <field name="woocommerce_billing_email" optional="hide"/>
        <field name="woocommerce_billing_phone" optional="hide"/>
        <field name="woocommerce_shipping_first_name" optional="hide"/>
        <field name="woocommerce_shipping_last_name" optional="hide"/>
        <field name="woocommerce_shipping_company" optional="hide"/>
        <field name="woocommerce_shipping_address_1" optional="hide"/>
        <field name="woocommerce_shipping_address_2" optional="hide"/>
        <field name="woocommerce_shipping_city" optional="hide"/>
        <field name="woocommerce_shipping_state" optional="hide"/>
        <field name="woocommerce_shipping_postcode" optional="hide"/>
        <field name="woocommerce_shipping_country" optional="hide"/>
        <field name="language_code" optional="hide"/>
      </xpath>
    </field>
  </record>
</odoo>
