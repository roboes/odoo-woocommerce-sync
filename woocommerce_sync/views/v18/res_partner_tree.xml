<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_res_partner_tree_woocommerce" model="ir.ui.view">
    <field name="name">res.partner.tree.woocommerce</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//list" position="inside">
        <field name="woocommerce_site_url" optional="show"/>
        <field name="woocommerce_id" optional="show"/>
        <field name="woocommerce_role" optional="show"/>
        <field name="woocommerce_is_paying_customer" optional="show"/>
        <field name="woocommerce_last_login_date" optional="show"/>
      </xpath>
    </field>
  </record>
</odoo>
