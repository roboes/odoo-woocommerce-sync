<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_product_template_form_woocommerce" model="ir.ui.view">
    <field name="name">product.template.form.woocommerce</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='options']" position="inside">
        <span class="d-inline-block">
          <field name="sync_to_woocommerce"/>
          <label for="sync_to_woocommerce"/>
        </span>
      </xpath>
      <xpath expr="//page[@name='general_information']//group[@name='group_general']" position="inside">
        <field name="language_code" attrs="{'invisible': ['|', ('language_code', '=', False), ('language_code', '=', '')]}"/>
        <field name="woocommerce_stock_last_sync" attrs="{'invisible': [('woocommerce_stock_last_sync', '=', False)]}"/>
      </xpath>
      <xpath expr="//page[@name='general_information']//field[@name='categ_id']" position="after">
        <field name="default_code" attrs="{'invisible': [('product_variant_count', '=', 1)]}"/>
      </xpath>
      <xpath expr="//page[@name='sales']//group[@name='sale']" position="after">
        <group string="Product Image Gallery">
          <p>To add images to the product image gallery, use Odoo's built-in Attachments feature in the product's Chatter.</p>
          <field name="product_image_ids" widget="many2many_kanban">
            <kanban quick_create="false" create="false" delete="false">
              <templates>
                <t t-name="kanban-box">
                  <div class="oe_kanban_global_click" style="width: 150px; height: 170px;">
                    <div class="d-flex align-items-center justify-content-center" style="width: 100%; height: 120px; overflow: hidden;">
                      <img t-attf-src="/web/content/ir.attachment/{{record.id.raw_value}}/datas?download=true" alt="Product Image" style="max-width: 100%; max-height: 100%; object-fit: contain;"/>
                    </div>
                    <div class="d-flex align-items-center justify-content-center" style="width: 100%; height: 50px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 5px;">
                      <strong class="o_kanban_record_title">
                        <field name="name"/>
                      </strong>
                    </div>
                  </div>
                </t>
              </templates>
            </kanban>
          </field>
        </group>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="WooCommerce" attrs="{'invisible': ['|', ('woocommerce_id', '=', False), ('woocommerce_id', '=', '')]}">
          <group string="General Information">
            <field name="woocommerce_site_url"/>
            <field name="woocommerce_to_odoo_last_sync"/>
            <field name="woocommerce_name"/>
            <field name="woocommerce_id"/>
            <field name="woocommerce_type"/>
            <field name="woocommerce_sku"/>
            <field name="language_code" attrs="{'invisible': ['|', ('language_code', '=', False), ('language_code', '=', '')]}"/>
            <field name="woocommerce_slug"/>
            <field name="woocommerce_permalink"/>
            <field name="woocommerce_date_created_gmt"/>
            <field name="woocommerce_date_modified_gmt"/>
            <field name="woocommerce_description"/>
            <field name="woocommerce_short_description"/>
            <field name="woocommerce_purchase_note"/>
          </group>
          <group string="Product Status">
            <field name="woocommerce_status"/>
            <field name="woocommerce_featured"/>
            <field name="woocommerce_purchasable"/>
            <field name="woocommerce_total_sales"/>
          </group>
          <group string="Pricing">
            <field name="woocommerce_regular_price" options="{'currency_field': 'currency_id'}"/>
            <field name="woocommerce_sale_price" options="{'currency_field': 'currency_id'}"/>
            <field name="woocommerce_date_on_sale_from_gmt"/>
            <field name="woocommerce_date_on_sale_to_gmt"/>
            <field name="woocommerce_price" options="{'currency_field': 'currency_id'}"/>
            <field name="woocommerce_on_sale"/>
          </group>
          <group string="Brands, Categories and Tags">
            <field name="woocommerce_categories" widget="json_html"/>
            <field name="woocommerce_tags" widget="json_html"/>
            <field name="woocommerce_brands" widget="json_html"/>
          </group>
          <group string="Variations and Attributes">
            <field name="woocommerce_variations" widget="json_html"/>
            <field name="woocommerce_attributes" widget="json_html"/>
            <field name="woocommerce_default_attributes" widget="html"/>
          </group>
          <group string="Stock and Inventory">
            <field name="woocommerce_manage_stock"/>
            <field name="woocommerce_stock_quantity"/>
            <field name="woocommerce_stock_status"/>
            <field name="woocommerce_sold_individually"/>
            <field name="woocommerce_backorders"/>
            <field name="woocommerce_backorders_allowed"/>
          </group>
          <group string="Shipping and Dimensions">
            <field name="woocommerce_weight"/>
            <field name="woocommerce_dimensions"/>
            <field name="woocommerce_shipping_required"/>
            <field name="woocommerce_shipping_taxable"/>
            <field name="woocommerce_shipping_class"/>
          </group>
          <group string="Meta Data" style="width: 100%; display: block;">
            <details>
              <summary>Meta Data</summary>
              <field name="woocommerce_meta_data" widget="json_html"/>
            </details>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
