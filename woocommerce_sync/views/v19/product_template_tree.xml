<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_product_template_tree_woocommerce" model="ir.ui.view">
    <field name="name">product.template.tree.woocommerce</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_tree_view"/>
    <field name="arch" type="xml">
      <xpath expr="//list" position="inside">
        <field name="woocommerce_connector_id" optional="show"/>
        <field name="woocommerce_site_url" optional="show"/>
        <field name="woocommerce_id" optional="show"/>
        <field name="woocommerce_type" optional="show"/>
        <field name="woocommerce_status" optional="show"/>
        <field name="woocommerce_featured" optional="hide"/>
        <field name="woocommerce_purchasable" optional="show"/>
        <field name="sync_to_woocommerce" optional="show"/>
        <field name="source" optional="show"/>
        <field name="language_code" optional="show"/>
      </xpath>
    </field>
  </record>
</odoo>
